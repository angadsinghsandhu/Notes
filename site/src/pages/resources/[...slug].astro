---
import ReaderLayout from '../../layouts/ReaderLayout.astro';
import { readPreparedBody, readPreparedCatalog } from '../../lib/catalog.js';
import type { ContentEntry } from '../../content/index.js';
export async function getStaticPaths() {
  const catalog = await readPreparedCatalog();
  const entries = catalog.listEntries();
  const notes = entries.filter((entry) =>
    ['markdown', 'notebook'].includes(entry.kind),
  );
  return Promise.all(
    entries
      .filter((entry) => !['markdown', 'notebook'].includes(entry.kind))
      .map(async (entry) => ({
        params: {
          slug: entry.route.slice('/resources/'.length).replace(/\/$/, ''),
        },
        props: {
          entry,
          html: await readPreparedBody(entry),
          navItems: notes.filter(
            (item) =>
              item.section === entry.section &&
              item.groupSegments.join('/') === entry.groupSegments.join('/'),
          ),
        },
      })),
  );
}
interface Props {
  entry: ContentEntry;
  html: string;
  navItems: ContentEntry[];
}
---

<ReaderLayout {...Astro.props} />
