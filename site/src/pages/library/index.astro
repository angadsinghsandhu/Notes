---
import LibraryLayout from '../../layouts/LibraryLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { readPreparedCatalog } from '../../lib/catalog.js';
import { buildFolders } from '../../lib/folders.js';
const folders = buildFolders((await readPreparedCatalog()).listEntries());
const noteCount = folders.reduce((sum, folder) => sum + folder.noteCount, 0);
const resourceCount = folders.reduce(
  (sum, folder) => sum + folder.resourceCount,
  0,
);
---

<LibraryLayout
  title="Library"
  description="Browse learning notes by subject, with course code and resources available separately."
>
  <Breadcrumbs title="Browse all" />
  <h1>Library</h1>
  <p data-library-notes>{noteCount} learning notes, organized by subject.</p>
  <p data-library-resources>
    {resourceCount} course code &amp; resources. Each folder lists learning
    notes and resources separately.
  </p>
  <nav aria-label="Browse by section" class="section-cards">
    {folders.map((folder) => (
      <a class="section-card" href={folder.route}>
        <h2>{folder.label}</h2>
        <p>
          {folder.noteCount} learning notes · {folder.resourceCount} resources
        </p>
      </a>
    ))}
  </nav>
  <p>
    <a href="/library/tree/">Explore the complete folder tree</a>
  </p>
</LibraryLayout>
