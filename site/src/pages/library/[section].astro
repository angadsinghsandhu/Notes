---
import LibraryLayout from '../../layouts/LibraryLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FolderContents from '../../components/FolderContents.astro';
import { readPreparedCatalog } from '../../lib/catalog.js';
import { buildFolders, type Folder } from '../../lib/folders.js';
export async function getStaticPaths() {
  return buildFolders((await readPreparedCatalog()).listEntries()).map(
    (folder) => ({
      params: { section: folder.section },
      props: { folder },
    }),
  );
}
interface Props {
  folder: Folder;
}
const { folder } = Astro.props;
---

<LibraryLayout
  title={folder.label}
  description={`Browse ${folder.label.toLowerCase()} learning notes and resources.`}
  folder={folder}
>
  <Breadcrumbs folder={folder} />
  <h1>{folder.label}</h1>
  <p>
    {folder.noteCount} learning notes · {folder.resourceCount} resources
  </p>
  <FolderContents folder={folder} />
</LibraryLayout>
