---
import LibraryLayout from '../layouts/LibraryLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Search from '../components/Search.astro';
---

<LibraryLayout
  title="Search"
  description="Search learning material or all published files by phrase, topic, collection, section, and kind."
>
  <Breadcrumbs title="Search" />
  <h1>Search</h1>
  <p>
    Search learning material by default. Choose All files to include project
    source code, supplemental references, and outlines. PDF and slide results
    include their metadata.
  </p>
  <Search />
</LibraryLayout>
