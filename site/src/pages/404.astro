---
import LibraryLayout from '../layouts/LibraryLayout.astro';
---

<LibraryLayout
  title="Page not found"
  description="Find your way back to the learning notes."
  noindex
>
  <h1>Page not found</h1>
  <p>This address is unavailable. Browse by subject or search for a phrase.</p>
  <div class="actions">
    <a class="action" href="/library/">
      Browse the library
    </a>
    <a class="action" href="/search/">
      Search the notes
    </a>
  </div>
</LibraryLayout>
