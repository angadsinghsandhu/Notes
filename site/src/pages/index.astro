---
import LibraryLayout from '../layouts/LibraryLayout.astro';
import {
  readPreparedCatalog,
  sectionLabels,
  isLearningNote,
} from '../lib/catalog.js';
const catalog = await readPreparedCatalog();
const entries = catalog.listEntries();
---

<LibraryLayout
  title="Notes Library"
  description="A library of notes from books, classes, courses, interviews, languages, and tutorials."
>
  <h1>Notes Library</h1>
  <p>
    Notes from books, classes, courses, interviews, languages, and tutorials.
  </p>
  <div class="actions">
    <a class="action" href="/search/">
      Search the notes
    </a>
    <a class="action" href="/library/">
      Browse the library
    </a>
  </div>
  <section aria-labelledby="sections-title" class="browse-section">
    <h2 id="sections-title">Browse by subject</h2>
    <div class="section-cards">
      {Object.entries(sectionLabels).map(([section, label]) => {
        const selected = entries.filter((entry) => entry.section === section);
        const notes = selected.filter(isLearningNote).length;
        return (
          <a class="section-card" href={`/library/${section}/`}>
            <h2>{label}</h2>
            <p>
              {notes} learning notes · {selected.length - notes} resources
            </p>
          </a>
        );
      })}
    </div>
  </section>
  <p class="muted">
    Start with learning notes. Course code, PDFs, and slides are available in
    each subject’s resources.
  </p>
</LibraryLayout>
