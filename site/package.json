{
  "name": "notes-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.1"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "check:boundaries": "eslint . --config eslint.boundaries.config.mjs --max-warnings 0",
    "typecheck": "astro check && tsc --project tsconfig.tools.json --noEmit",
    "check": "npm run format:check && npm run lint && npm run check:boundaries && npm run typecheck && npm run test:unit",
    "build": "npm run content:check && astro build && pagefind --site dist && npm run check:output",
    "preview": "astro preview --host 127.0.0.1",
    "test:unit": "vitest run --coverage --coverage.thresholds.perFile --coverage.thresholds.lines 90 --coverage.thresholds.functions 90 --coverage.thresholds.statements 90 --coverage.thresholds.branches 90",
    "test:e2e": "playwright test",
    "verify": "npm run build && npm run check && npm run test:e2e && npm run check:output",
    "content:check": "tsx scripts/content.ts",
    "content:migrate": "tsx scripts/migrate.ts",
    "check:output": "tsx scripts/verify-output.ts"
  },
  "dependencies": {
    "astro": "7.3.5",
    "cbor-x": "1.6.6",
    "github-slugger": "2.0.0",
    "hast-util-from-html": "2.0.3",
    "hast-util-sanitize": "5.0.2",
    "hast-util-to-html": "9.0.5",
    "katex": "0.19.0",
    "rehype-raw": "7.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "saxes": "6.0.0",
    "sharp": "0.35.5",
    "shiki": "4.5.0",
    "unified": "11.0.5",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/jsdom": "30.0.0",
    "@types/katex": "0.16.8",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "chokidar": "5.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "jsdom": "30.1.2",
    "pagefind": "1.5.2",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
